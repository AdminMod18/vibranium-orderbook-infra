# Evita que Git en Windows convierta a CRLF los archivos que se ejecutan en Linux (scripts, manifiestos): con CRLF, bash falla con "bad interpreter".
* text=auto
*.sh   text eol=lf
*.py   text eol=lf
*.js   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.svg  text eol=lf
*.png  binary
Makefile text eol=lf
